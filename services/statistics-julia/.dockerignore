.env
.env.local

# Logs
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Docker
Dockerfile
.dockerignore
docker-compose*.yml

# Documentation
*.md
!README.md

# Manifest/Project (copied explicitly in Dockerfile)
Manifest.toml
Project.toml