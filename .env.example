# NexusAI - Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env files to version control

# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=3001
API_VERSION=v1

# ============================================
# Frontend (CORS)
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
# Database (PostgreSQL / Supabase)
# ============================================
# DATABASE_URL=postgresql://user:password@localhost:5432/nexusai?schema=public
# For Supabase: postgresql://postgres:[password]@db.[ref].supabase.co:6543/postgres
# DATABASE_URL=

# ============================================
# Supabase Authentication (Phase 2)
# ============================================
# Get these from Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Datasets & Storage (Phase 3)
# ============================================
# local = filesystem under ./uploads (dev only, never use ephemeral disk in prod)
# supabase = private Supabase Storage bucket (requires SUPABASE_SERVICE_ROLE_KEY)
STORAGE_DRIVER=local
STORAGE_BUCKET=datasets
# Max CSV upload size in MB (server-enforced, clients cannot raise it)
MAX_UPLOAD_MB=10

# ============================================
# ML Service (Phase 4, internal only)
# ============================================
# The Node API calls the Python service server-side. Never expose these to the frontend.
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_KEY=dev-ml-service-key
# Max time to wait for a training response (ms).
ML_TIMEOUT_MS=120000

# ============================================
# Julia Statistics Service (Phase 5, internal only)
# ============================================
# The Node API calls the Julia service server-side. Never expose these to the frontend.
JULIA_SERVICE_URL=http://localhost:8001
JULIA_SERVICE_KEY=dev-julia-service-key
# Max time to wait for an analysis response (ms).
JULIA_TIMEOUT_MS=60000

# ============================================
# Future Services
# ============================================
# ML Python Service
ML_PYTHON_URL=http://localhost:8000
ML_PYTHON_API_KEY=

# Statistics Julia Service
STATISTICS_JULIA_URL=http://localhost:8001
STATISTICS_JULIA_API_KEY=

# Redis (for async job queues)
REDIS_URL=redis://localhost:6379

# LLM Provider (OpenAI, Anthropic, or local)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ============================================
# Authentication (Future)
# ============================================
# JWT_SECRET=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
# JWT_EXPIRES_IN=7d

# ============================================
# Monitoring (Future)
# ============================================
# SENTRY_DSN=
# LOG_LEVEL=info